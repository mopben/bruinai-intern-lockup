{
  "name": "dry-run",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Dry Run: scan your kitchen, change one thing, and watch the rush again.",
  "scripts": {
    "start": "node tools/start.mjs",
    "dev": "vite",
    "build": "vite build",
    "serve": "tsx server/main.ts",
    "fixtures": "tsx tools/world/make-fixtures.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "acceptance": "playwright test",
    "check": "npm run typecheck && npm run test && npm run acceptance"
  },
  "dependencies": {
    "@fontsource-variable/baloo-2": "^5.3.0",
    "@fontsource-variable/nunito": "^5.3.0",
    "@preact/signals": "^2.11.4",
    "preact": "^11.2.0",
    "three": "^0.187.0",
    "ws": "^8.23.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^26.6.6",
    "@types/three": "^0.187.0",
    "@types/ws": "^8.18.2",
    "@vitest/coverage-v8": "^5.1.0",
    "jsdom": "^31.0.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
